{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "kind": {
      "type": "string",
      "const": "annotation"
    },
    "structureId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "residueKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
    },
    "ptm": {
      "type": "string",
      "enum": [
        "phosphorylation",
        "methylation",
        "glycosylation",
        "other"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "evidence": {
      "readOnly": true,
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user-annotation",
            "source-record",
            "literature"
          ]
        },
        "citation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "coordinatesChanged": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "structureId",
    "residueKey",
    "ptm",
    "label",
    "createdAt",
    "evidence",
    "coordinatesChanged"
  ],
  "additionalProperties": false,
  "title": "PtmAnnotation",
  "$comment": "TypeScript Zod refinements remain authoritative for semantic cross-reference validation."
}
