{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "structureId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "modelId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "residueKeys": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
      }
    },
    "atomKeys": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
      }
    }
  },
  "required": [
    "structureId",
    "modelId",
    "residueKeys",
    "atomKeys"
  ],
  "additionalProperties": false,
  "title": "RendererSelection",
  "$comment": "TypeScript Zod refinements remain authoritative for semantic cross-reference validation."
}
