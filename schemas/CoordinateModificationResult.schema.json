{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "kind": {
      "type": "string",
      "const": "constructed-chemistry"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "inputStructureId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "outputStructureId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "residueKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
    },
    "chemistry": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "parameterSet": {
      "type": "string",
      "minLength": 1
    },
    "engineVersion": {
      "type": "string",
      "minLength": 1
    },
    "validationReport": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "jobId",
    "inputStructureId",
    "outputStructureId",
    "residueKey",
    "chemistry",
    "method",
    "parameterSet",
    "engineVersion",
    "validationReport"
  ],
  "additionalProperties": false,
  "title": "CoordinateModificationResult",
  "$comment": "TypeScript Zod refinements remain authoritative for semantic cross-reference validation."
}
