{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "kind": {
      "type": "string",
      "const": "construct-ptm"
    },
    "structureId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "residueKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
    },
    "chemistry": {
      "type": "string",
      "enum": [
        "phosphorylation",
        "methylation",
        "glycosylation"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "jobId",
    "kind",
    "structureId",
    "residueKey",
    "chemistry"
  ],
  "additionalProperties": false,
  "title": "CoordinateModificationRequest",
  "$comment": "TypeScript Zod refinements remain authoritative for semantic cross-reference validation."
}
