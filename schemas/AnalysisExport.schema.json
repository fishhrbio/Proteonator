{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "format": {
      "type": "string",
      "const": "proview-geometry-export"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "coordinateUnit": {
      "type": "string",
      "const": "angstrom"
    },
    "result": {
      "readOnly": true,
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "kind": {
          "type": "string",
          "const": "interface-geometry"
        },
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "structureId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "modelId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "partnerAChainKeys": {
          "readOnly": true,
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
          }
        },
        "partnerBChainKeys": {
          "readOnly": true,
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
          }
        },
        "minimumDistance": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "atomAKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
            },
            "atomBKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
            },
            "residueAKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
            },
            "residueBKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
            },
            "distanceAngstrom": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "atomAKey",
            "atomBKey",
            "residueAKey",
            "residueBKey",
            "distanceAngstrom"
          ],
          "additionalProperties": false
        },
        "contacts": {
          "readOnly": true,
          "type": "array",
          "items": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "atomAKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
              },
              "atomBKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
              },
              "residueAKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
              },
              "residueBKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
              },
              "distanceAngstrom": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "atomAKey",
              "atomBKey",
              "residueAKey",
              "residueBKey",
              "distanceAngstrom"
            ],
            "additionalProperties": false
          }
        },
        "clashCandidates": {
          "readOnly": true,
          "type": "array",
          "items": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "atomAKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
              },
              "atomBKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
              },
              "residueAKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
              },
              "residueBKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[A-Za-z0-9_:/%.+~-]+$"
              },
              "distanceAngstrom": {
                "type": "number",
                "minimum": 0
              },
              "radiusAAngstrom": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "radiusBAngstrom": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "overlapAngstrom": {
                "type": "number",
                "exclusiveMinimum": 0.4
              },
              "interpretation": {
                "type": "string",
                "const": "geometric-candidate"
              }
            },
            "required": [
              "atomAKey",
              "atomBKey",
              "residueAKey",
              "residueBKey",
              "distanceAngstrom",
              "radiusAAngstrom",
              "radiusBAngstrom",
              "overlapAngstrom",
              "interpretation"
            ],
            "additionalProperties": false
          }
        },
        "summary": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "selectedAtomCountA": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "selectedAtomCountB": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "evaluatedPairCount": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "contactCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "contactResiduePairCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "clashCandidateCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "knownBondExcludedPairCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unknownRadiusPairCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "selectedAtomCountA",
            "selectedAtomCountB",
            "evaluatedPairCount",
            "contactCount",
            "contactResiduePairCount",
            "clashCandidateCount",
            "knownBondExcludedPairCount",
            "unknownRadiusPairCount"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "engineVersion": {
              "type": "string",
              "const": "proview-geometry-1"
            },
            "method": {
              "type": "string",
              "const": "cross-partner-euclidean-heavy-atom-pairs"
            },
            "computedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "sourceSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "structureId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "modelId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "coordinateUnit": {
              "type": "string",
              "const": "angstrom"
            },
            "evidenceClass": {
              "type": "string",
              "const": "derived-geometry"
            },
            "altLocPolicy": {
              "type": "string",
              "const": "residue-mean-occupancy;tie-A-then-lexical;shared-blank-wins;zero-occupancy-excluded"
            },
            "selectionPolicy": {
              "type": "string",
              "const": "canonical-protein-ATOM;known-heavy-elements;positive-or-missing-occupancy"
            },
            "contactCutoffAngstrom": {
              "type": "number",
              "const": 4
            },
            "clashOverlapThresholdAngstrom": {
              "type": "number",
              "const": 0.4
            },
            "radiiSet": {
              "type": "string",
              "const": "Bondi-1964-subset-C-N-O-S-P"
            },
            "bondExclusionPolicy": {
              "type": "string",
              "const": "exclude-explicit-CONECT-1-2-and-1-3-from-overlaps;contacts-include-all"
            },
            "topologyCompleteness": {
              "type": "string",
              "enum": [
                "unknown",
                "partial"
              ]
            },
            "clashInterpretation": {
              "type": "string",
              "const": "geometric-candidates-only"
            },
            "limitations": {
              "readOnly": true,
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "engineVersion",
            "method",
            "computedAt",
            "sourceSha256",
            "structureId",
            "modelId",
            "coordinateUnit",
            "evidenceClass",
            "altLocPolicy",
            "selectionPolicy",
            "contactCutoffAngstrom",
            "clashOverlapThresholdAngstrom",
            "radiiSet",
            "bondExclusionPolicy",
            "topologyCompleteness",
            "clashInterpretation",
            "limitations"
          ],
          "additionalProperties": false
        },
        "diagnostics": {
          "readOnly": true,
          "type": "array",
          "items": {
            "readOnly": true,
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warning"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "code",
              "severity",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "jobId",
        "structureId",
        "modelId",
        "partnerAChainKeys",
        "partnerBChainKeys",
        "minimumDistance",
        "contacts",
        "clashCandidates",
        "summary",
        "provenance",
        "diagnostics"
      ],
      "additionalProperties": false
    },
    "source": {
      "readOnly": true,
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "kind": {
          "type": "string",
          "enum": [
            "local-file",
            "bundled-fixture",
            "remote-accession",
            "synthetic-test"
          ]
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "accession": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "evidenceClass": {
          "type": "string",
          "enum": [
            "observed-structure",
            "supplied-coordinates",
            "model-based-prediction",
            "synthetic-fixture"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "pdb",
            "mmcif"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "name",
        "kind",
        "format",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "format",
    "exportedAt",
    "coordinateUnit",
    "result",
    "source"
  ],
  "additionalProperties": false,
  "title": "AnalysisExport",
  "$comment": "TypeScript Zod refinements remain authoritative for semantic cross-reference validation."
}
