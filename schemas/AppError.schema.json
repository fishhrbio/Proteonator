{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "INVALID_INPUT",
        "UNSUPPORTED_FORMAT",
        "UNSUPPORTED_CHEMISTRY",
        "MISSING_COORDINATES",
        "AMBIGUOUS_MAPPING",
        "COMPUTATION_FAILED",
        "CANCELLED",
        "RESOURCE_LIMIT",
        "OPTIONAL_SERVICE_MISSING",
        "OFFLINE",
        "UPLOAD_NOT_AUTHORIZED",
        "UNSUPPORTED_PROJECT_VERSION"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "recovery": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    }
  },
  "required": [
    "code",
    "message",
    "recovery"
  ],
  "additionalProperties": false,
  "title": "AppError",
  "$comment": "TypeScript Zod refinements remain authoritative for semantic cross-reference validation."
}
