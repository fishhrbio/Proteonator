{
  "name": "proteonator",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "A local molecular workspace for structures, precursor chemistry, coding sequences and reproducible comparisons",
  "author": "Robert Waite",
  "main": "dist/main.cjs",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "setup:electron": "install-electron",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dev": "pnpm build && pnpm start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "make:icon": "node scripts/make-brand.mjs",
    "pack:dir": "electron-builder --dir --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "test:studio": "node scripts/verify-studio.mjs",
    "test:molecule": "python compute/test_molecule.py",
    "test:physics": "python compute/verify_physics.py",
    "test:extended": "node scripts/verify-studio-extended.mjs",
    "test:studio-physics": "node scripts/verify-studio-physics.mjs",
    "freeze:compute": "python scripts/freeze-compute.py",
    "guides": "python scripts/render-guides.py",
    "test:desktop": "node scripts/verify-studio-desktop.mjs",
    "test:stereochemistry": "python compute/verify_stereochemistry.py",
    "test:sequence": "node scripts/verify-sequence.mjs",
    "test:workflows": "node scripts/verify-new-workflows.mjs",
    "test:release": "node scripts/verify-release.mjs",
    "test:chemistry": "python -m unittest discover -s compute -p \"test_*.py\"",
    "test:archives": "python scripts/verify-export-archives.py",
    "test:video": "python scripts/verify-video-decode.py",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:linux": "electron-builder --linux deb --publish never",
    "make:platform-icons": "node scripts/make-platform-icons.mjs"
  },
  "dependencies": {
    "3dmol": "2.5.5",
    "molstar": "5.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.6",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "org.robertwaite.proteonator",
    "productName": "Proteonator",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "licenses/**/*",
      "!node_modules/**/*",
      "!dist/**/*.map"
    ],
    "extraResources": [
      {
        "from": "compute-dist/ProteonatorCompute",
        "to": "compute"
      },
      {
        "from": "fixtures/structures",
        "to": "examples",
        "filter": [
          "*.pdb",
          "*.cif"
        ]
      },
      {
        "from": "docs/USER_GUIDE.html",
        "to": "USER_GUIDE.html"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "LICENSE",
        "to": "Proteonator-LICENSE.txt"
      },
      {
        "from": "docs/SCIENCE.html",
        "to": "SCIENCE.html"
      },
      {
        "from": "fixtures/PROVENANCE.json",
        "to": "examples/PROVENANCE.json"
      },
      {
        "from": "data/PROVENANCE.json",
        "to": "compute/data-PROVENANCE.json"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "fileAssociations": [
        {
          "ext": "proteonator",
          "name": "Proteonator project",
          "description": "Portable Proteonator molecular and sequence project",
          "role": "Editor",
          "icon": "assets/icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Proteonator",
      "uninstallDisplayName": "Proteonator 1.2.1",
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "selectPerMachineByDefault": false,
      "include": "scripts/installer.nsh",
      "allowElevation": false,
      "packElevateHelper": false,
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer-sidebar.bmp"
    },
    "publish": null,
    "artifactName": "Proteonator-Setup-${version}-${arch}.${ext}",
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.education",
      "minimumSystemVersion": "15.0",
      "identity": "-",
      "notarize": false,
      "hardenedRuntime": false,
      "fileAssociations": [
        {
          "ext": "proteonator",
          "name": "Proteonator project",
          "description": "Portable Proteonator molecular and sequence project",
          "role": "Editor",
          "icon": "assets/icon.icns"
        }
      ],
      "artifactName": "Proteonator-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Proteonator ${version}",
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 160,
          "type": "file"
        },
        {
          "x": 410,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-512.png",
      "executableName": "proteonator",
      "category": "Science",
      "maintainer": "Robert Waite <fishhrbio@users.noreply.github.com>",
      "fileAssociations": [
        {
          "ext": "proteonator",
          "name": "Proteonator project",
          "description": "Portable Proteonator molecular and sequence project",
          "role": "Editor",
          "icon": "assets/icon-512.png",
          "mimeType": "application/x-proteonator-project"
        }
      ],
      "artifactName": "Proteonator-${version}-linux-${arch}.${ext}",
      "mimeTypes": [
        "application/x-proteonator-project"
      ]
    }
  },
  "homepage": "https://github.com/fishhrbio/Proteonator",
  "repository": {
    "type": "git",
    "url": "https://github.com/fishhrbio/Proteonator.git"
  }
}
